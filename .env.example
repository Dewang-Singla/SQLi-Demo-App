# Copy this file to .env and fill in your values before running the app.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# Session secret — set a long random string for repeatable runs
SESSION_SECRET=replace_this_with_a_long_random_string

# Demo mode: 'on' = vulnerable (educational), 'off' = secure
VULN_MODE=on

# Reset confirmation phrase (admin must type this exactly to reset the DB)
RESET_CONFIRM_PHRASE=RESET DEMO

# OTP and verification settings (in minutes)
OTP_TTL_MINUTES=10

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DATABASE=sqlidemo

# ── Seed passwords ───────────────────────────────────────────────────────────
# If omitted, random passwords are generated at startup and printed to console.
SEED_ADMIN_PASSWORD=
SEED_ALICE_PASSWORD=
SEED_BOB_PASSWORD=

# ── Email (optional) ─────────────────────────────────────────────────────────
# If not set, verification codes are shown on-screen instead of emailed.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
