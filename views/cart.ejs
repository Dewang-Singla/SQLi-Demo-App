<%- include('partials/header', { title: 'Shopping Cart' }) %>

<h2>🛒 Shopping Cart</h2>

<% if (cart.length === 0) { %>
  <div class="card" style="text-align:center;padding:3rem;margin:2rem 0">
    <h3>Your cart is empty</h3>
    <p style="color:#a8c1f5;margin:1rem 0">Add some products to get started!</p>
    <a href="/products" class="btn primary">Browse Products</a>
  </div>
<% } else { %>
  <table class="table" style="margin:2rem 0">
    <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Subtotal</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% cart.forEach(item => { %>
        <tr>
          <td>
            <div style="display:flex;align-items:center;gap:1rem">
              <img src="<%= getImagePath(item.image_url) %>" alt="<%= item.name %>">
              <strong><%= item.name %></strong>
            </div>
          </td>
          <td>$<%= item.price.toFixed(2) %></td>
          <td>
            <form method="post" action="/cart/update/<%= item.id %>" style="display:inline-block">
              <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="99" style="width:60px;padding:0.3rem" onchange="this.form.submit()">
            </form>
          </td>
          <td><strong>$<%= (item.price * item.quantity).toFixed(2) %></strong></td>
          <td>
            <form method="post" action="/cart/remove/<%= item.id %>" style="display:inline">
              <button type="submit" class="btn btn-sm warn">Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr style="border-top:2px solid #3a4a80">
        <td colspan="3" style="text-align:right;font-weight:700;font-size:1.2rem">Total:</td>
        <td colspan="2" style="font-weight:700;font-size:1.2rem;color:#5b9aff">$<%= Number(total).toFixed(2) %></td>
      </tr>
    </tfoot>
  </table>

  <div style="display:flex;gap:1rem;justify-content:flex-end;margin:2rem 0">
    <a href="/products" class="btn secondary">Continue Shopping</a>
    <% if (user) { %>
      <a href="/checkout" class="btn primary">Proceed to Checkout →</a>
    <% } else { %>
      <a href="/login" class="btn primary">Login to Checkout</a>
    <% } %>
  </div>
<% } %>

<%- include('partials/footer') %>
