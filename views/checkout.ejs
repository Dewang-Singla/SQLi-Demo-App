<%- include('partials/header', { title: 'Checkout' }) %>

<h2>💳 Checkout</h2>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:2rem;margin:2rem 0">
  <div>
    <div class="card">
      <h3 style="margin-bottom:1rem">Payment Information</h3>
      <form method="post" action="/checkout">
        <label>Card Number
          <input type="text" name="card_number" placeholder="1234 5678 9012 3456" required pattern="[0-9]{13,19}" maxlength="19">
        </label>
        
        <label>Card Holder Name
          <input type="text" name="card_holder" placeholder="John Doe" required>
        </label>
        
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <label>Expiry Date
            <input type="text" name="expiry" placeholder="MM/YY" required pattern="[0-9]{2}/[0-9]{2}" maxlength="5">
          </label>
          
          <label>CVV
            <input type="text" name="cvv" placeholder="123" required pattern="[0-9]{3,4}" maxlength="4">
          </label>
        </div>
        
        <button type="submit" class="btn primary" style="width:100%">Complete Order</button>
      </form>
    </div>
    
    <div class="hint" style="margin-top:2rem">
      <h3>⚠️ Security Warning</h3>
      <p>This demo stores payment info in plaintext in the database. <strong>Never do this in production!</strong></p>
      <p>This is intentionally insecure for educational purposes only.</p>
    </div>
  </div>
  
  <div>
    <div class="card">
      <h3 style="margin-bottom:1rem">Order Summary</h3>
      <% cart.forEach(item => { %>
        <div style="display:flex;justify-content:space-between;margin:0.75rem 0;padding-bottom:0.75rem;border-bottom:1px solid #1b2a4d">
          <div>
            <div style="font-weight:600"><%= item.name %></div>
            <div style="font-size:0.85rem;color:#a8c1f5">Qty: <%= item.quantity %></div>
          </div>
          <div style="font-weight:600;color:#5b9aff">$<%= (Number(item.price) * item.quantity).toFixed(2) %></div>
        </div>
      <% }) %>
      
      <div style="display:flex;justify-content:space-between;margin-top:1.5rem;padding-top:1rem;border-top:2px solid #3a4a80;font-size:1.3rem;font-weight:700">
        <div>Total:</div>
        <div style="color:#5b9aff">$<%= Number(total).toFixed(2) %></div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
